# Secrets only; copy to .env and fill in. `make` passes it to the container.
# Every other setting lives in robot.toml (template: robot.example.toml).

# Claude login, one of the two (docs/CLAUDE_ACCESS.md):
# - Claude Code on your subscription (claude.backend = "cli"): `make claude-token`
CLAUDE_CODE_OAUTH_TOKEN=
# - The Claude API, billed per use (claude.backend = "api"): a key from platform.claude.com
ANTHROPIC_API_KEY=
