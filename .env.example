# Copy to .env and fill in. `make` passes it to the container.

# ---- Claude ----
# Two ways to reach Claude (docs/CLAUDE_ACCESS.md):
#   cli: `claude -p` (Claude Code) on your Claude subscription. Run `make claude-token`
#        once and paste the token below.
#   api: the Claude API with an API key from platform.claude.com, billed per use.
#   auto: api if ANTHROPIC_API_KEY is set, otherwise cli.
CLAUDE_BACKEND=cli
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high. Low is plenty for "what should I say?" and keeps cost down.
CLAUDE_EFFORT=low
# 1 = never call Claude; log the prompt it would have sent. Good for offline testing.
ROBOT_DRY_RUN=0

# ---- Personality ----
ROBOT_NAME=Robo

# ---- Speech output ----
# language=engine:voice, comma separated; the first one is the default.
# engine is piper (natural, voice model in models/) or espeak (robotic, ~100 languages).
# There's no Croatian Piper voice; the Serbian one reads Croatian text well.
# Alternative: hr=espeak:hr
TTS_VOICES=en=piper:en_US-lessac-low,hr=piper:sr_RS-serbski_institut-medium
# Defaults to paplay when PULSE_SERVER is set (desktop), else aplay (Pi).
# AUDIO_PLAYER=aplay

# ---- Listening (docs/WAKEWORD.md) ----
# 1 = `make run` also listens to the microphone.
ROBOT_LISTEN=1
# Pretrained "hey_jarvis", or the name of your own model in data/wakeword/<name>.onnx
WAKEWORD=hey_jarvis
WAKEWORD_THRESHOLD=0.5
# tiny | base (in the image) | small (may help Croatian, ~3x slower; downloaded to data/whisper once)
WHISPER_MODEL=base
# Languages to expect; the first one wins when unsure.
STT_LANGUAGES=en,hr
# Defaults to parec when PULSE_SERVER is set (desktop), else arecord (Pi).
# AUDIO_RECORDER=arecord -q -t raw -f S16_LE -r 16000 -c 1

# ---- Vision ----
ROBOT_MIN_CONFIDENCE=0.5
# Cosine similarity needed to call a face by name. Raise it if strangers get your name.
ROBOT_FACE_THRESHOLD=0.363
# Don't ask Claude again about an unchanged scene within this many seconds.
ROBOT_COOLDOWN_S=60
# 1 = keep Motion's snapshots in data/snapshots (default deletes them after processing).
ROBOT_KEEP_SNAPSHOTS=0
